{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(firebase deploy *)",
      "PowerShell(firebase deploy *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-stop.ps1\"",
            "timeout": 30000,
            "async": false,
            "statusMessage": "Formateando archivos cambiados"
          }
        ]
      }
    ]
  }
}
